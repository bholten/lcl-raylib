;; 3D camera + keyboard/mouse input -- run with: build/lcl-raylib examples/camera3d.lcl
;;
;;   WASD / mouse   move the camera (raylib CAMERA_FREE mode)
;;   space          toggle wireframe
;;   escape         quit
import raylib

init_window 800 600 "Lcl + raylib: 3D"
set_target_fps 60

;; Camera3D fields: position target up fovy projection.
;; The struct is a mutable opaque value; update_camera moves it in place.
let cam [camera_3d (10 10 10) (0 0 0) (0 1 0) 45.0 $CAMERA_PERSPECTIVE]

var wire 0
let cubes ((0 1 0) (4 1 -2) (-3 1 3) (2 1 5))

while {not [window_should_close]} {
    update_camera $cam $CAMERA_FREE

    if [is_key_pressed $KEY_SPACE] {
        set! wire [not $wire]
    }

    begin_drawing
    clear_background $RAYWHITE

    begin_mode_3d $cam
    draw_grid 20 1.0

    foreach pos $cubes {
        if $wire {
            draw_cube_wires $pos 2 2 2 $MAROON
        } else {
            draw_cube $pos 2 2 2 $RED
            draw_cube_wires $pos 2 2 2 $MAROON
        }
    }

    end_mode_3d

    let p [camera_3d_position $cam]

    draw_text "camera: [vector3_x $p] [vector3_y $p] [vector3_z $p]" 10 10 20 $DARKGRAY
    draw_text "WASD + mouse: move | space: wireframe" 10 [- [get_screen_height] 30] 20 $GRAY
    draw_fps [- [get_screen_width] 100] 10
    end_drawing
}

close_window
