;; Run the `;;; Examples:` doctests in lib/raylib/src/Raylib.lcl.
;;
;;   build/lcl-raylib test/doctest.lcl <path/to/lcl/lib/doc/src/Doc.lcl>
;;
;; (ctest runs this with the Doc.lcl from the fetched lcl source.)
;; The Raylib layer itself is already loaded by the runner.
if [< [len $argv] 1] {
    error "usage: doctest.lcl <Doc.lcl>"
}

load [get $argv 0]

-> [raylib::load_file_text "lib/raylib/src/Raylib.lcl"] \
    {Doc::extract} \
    {Doc::doctest} \
    {Doc::report}
